<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnapphaneScoutDistriktBookingApp.Views.Booking.BookingStep4View">
    <VerticalStackLayout>
        <Entry
            Placeholder="För och efternamn"
            Text="{Binding NewBooking.Name, Mode=TwoWay}"
            Keyboard="Chat" />
        <Entry
            Placeholder="Telefonnummer"
            Text="{Binding NewBooking.Phone, Mode=TwoWay}"
            Keyboard="Numeric" />
        <Entry
            Placeholder="Email"
            Text="{Binding NewBooking.Email, Mode=TwoWay}"
            Keyboard="Email"
            TextTransform="None" />
        <HorizontalStackLayout>
            <Label Text="Scoutmedlem" />
            <CheckBox IsChecked="{Binding IsScoutMember, Mode=TwoWay}" CheckedChanged="OnCheckChange" />
        </HorizontalStackLayout>
        <Label Text="Scoutkårens namn" IsVisible="{Binding ShowOrgNameInput}" HorizontalTextAlignment="Center" />
        <Entry
            Placeholder="Scoutkår"
            Text="{Binding NewBooking.OrgName, Mode=TwoWay}"
            IsVisible="{Binding ShowOrgNameInput}" />
    </VerticalStackLayout>
</ContentView>
