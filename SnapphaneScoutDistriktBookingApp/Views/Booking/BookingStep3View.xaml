<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:cal="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
             x:Class="SnapphaneScoutDistriktBookingApp.Views.Booking.BookingStep3View"
             Loaded="OnLoaded"
             BindingContext="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}}">
    <VerticalStackLayout>
        <Label
            Text="Välj datum och tid för bokning."
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <cal:SfCalendar
            x:Name="BookingCalendar"
            SelectionMode="Range"
            EnablePastDates="False"
            SelectionChanged="OnCalendarSelectionChanged">
            
            <cal:SfCalendar.MonthView>
                <cal:CalendarMonthView FirstDayOfWeek="Monday" DisabledDatesBackground="DarkGrey" />
            </cal:SfCalendar.MonthView>
        </cal:SfCalendar>

        <picker:SfTimePicker
            x:Name="StartTimePicker"
            Format="HH_mm"
            MinuteInterval="15"
            TextDisplayMode="FadeAndShrink"
            Mode="Dialog"
            SelectionChanged="OnStartTimeChanged"
            SelectedTime="{Binding StartTime, Mode=TwoWay}">
            <picker:SfTimePicker.HeaderView>
                <picker:PickerHeaderView Text="Tid för start" Height="40" />
            </picker:SfTimePicker.HeaderView>
        </picker:SfTimePicker>

        <picker:SfTimePicker
            x:Name="EndTimePicker"
            Format="HH_mm"
            MinuteInterval="15"
            TextDisplayMode="FadeAndShrink"
            Mode="Dialog"
            SelectionChanged="OnEndTimeChanged"
            SelectedTime="{Binding EndTime, Mode=TwoWay}">
            <picker:SfTimePicker.HeaderView>
                <picker:PickerHeaderView Text="Tid för avslutning" Height="40" />
            </picker:SfTimePicker.HeaderView>
        </picker:SfTimePicker>
        
        <Grid
                ColumnDefinitions="*, *"
                RowDefinitions="auto, auto"
                Padding="10"
                RowSpacing="20"
                ColumnSpacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Center" >
            <Button x:Name="StartTimeButton" Text="{Binding StartTimeButtonText}" Clicked="OnStartClicked" Grid.Row="0" Grid.Column="0" />
            <Button x:Name="EndTimeButton" Text="{Binding EndTimeButtonText}" Clicked="OnEndClicked" Grid.Row="0" Grid.Column="1" />
        </Grid>
        
    </VerticalStackLayout>
</ContentView>
