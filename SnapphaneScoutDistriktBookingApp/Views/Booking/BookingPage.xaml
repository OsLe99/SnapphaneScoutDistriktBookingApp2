<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnapphaneScoutDistriktBookingApp.Views.Booking.BookingPage"
             Title="Bokningssida"
             >

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <Label 
                Text="Vad vill du boka?"
                Style="{StaticResource Headline}"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <Grid
                ColumnDefinitions="*, *"
                RowDefinitions="auto, auto"
                Padding="10"
                RowSpacing="20"
                ColumnSpacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Center" >
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    x:Name="BookCanoe"
                    Text="Kanot"
                    Clicked="OnChangeToMoreInfoAsync">
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    x:Name="BookLeanTo"
                    Text="Vindskydd"
                    Clicked="OnChangeToMoreInfoAsync">
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    x:Name="BookCampGrounds"
                    Text="Lägerområde"
                    Clicked="OnChangeToMoreInfoAsync">
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    x:Name="BookCabin"
                    Text="Stugan"
                    Clicked="OnChangeToMoreInfoAsync">
                </Button>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>