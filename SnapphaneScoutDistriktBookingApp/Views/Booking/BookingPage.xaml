<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnapphaneScoutDistriktBookingApp.Views.Booking.BookingPage"
             Title="Bokningssida">
    <Grid RowDefinitions="Auto, *, Auto">

        <Label Grid.Row="0"
               HorizontalOptions="Center"
               FontSize="18"
               FontAttributes="Bold"
               Margin="0,10,0,10"
               Text="{Binding StepInfo}">
        </Label>

        <ContentView
            Grid.Row="1"
            Content="{Binding CurrentView}" />

        <HorizontalStackLayout
            Grid.Row="2"
            Padding="10"
            Spacing="10"
            HorizontalOptions="Center">
            <Button
                Text="Tillbaka"
                Command="{Binding GoToPreviousStepCommand}"
                IsVisible="{Binding CanGoToPreviousStep}" />
            <Button
                Text="Nästa"
                Command="{Binding GoToNextStepCommand}"
                IsVisible="{Binding CanGoToNextStep}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
