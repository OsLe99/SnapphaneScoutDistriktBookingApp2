<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnapphaneScoutDistriktBookingApp.Views.InfoPage"
             Title="InfoPage">
    <VerticalStackLayout>
        
        <Label Text="Kontakter" FontSize="20"></Label>
        <ListView ItemsSource="{Binding Contacts}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" RowDefinitions="Auto, Auto, *" ColumnDefinitions="0,200,260, 200" ColumnSpacing="20">
                            <Label Grid.Column="1" Text="{Binding Name}" ></Label>
                            <Label Grid.Column="2" Text="{Binding Email}" ></Label>
                            <Label Grid.Column="3" Text="{Binding PhoneNumber}"></Label>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Label Text="Info" FontSize="20" Margin="0,20,0,0"></Label>
        <ListView ItemsSource="{Binding InfoList}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" RowDefinitions="Auto, Auto, *" ColumnDefinitions="0, 200, 260, 200" ColumnSpacing="20">
                            <Label Grid.Column="1" Text="{Binding InfoString}"></Label>
                            <Label Grid.Column="2" Text="{Binding CreatedAt, StringFormat='Skapad: {0:yyyy-MM-dd HH-mm}'}"></Label>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>