<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnapphaneScoutDistriktBookingApp.Views.MainPage"
             >

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <Image
                Source="logga.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Logga för hultet" />

            <Label
                Text="{Binding UserName, StringFormat='Välkommen {0}!'}"
                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Snapphane Scoutdistrikt"
                FontFamily="OldGerman"
                Style="{StaticResource SubHeadline}"
                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Välkommen" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
