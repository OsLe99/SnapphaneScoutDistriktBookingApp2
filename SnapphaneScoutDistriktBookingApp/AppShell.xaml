<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SnapphaneScoutDistriktBookingApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SnapphaneScoutDistriktBookingApp.Views"
    xmlns:booking="clr-namespace:SnapphaneScoutDistriktBookingApp.Views.Booking"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False"
    Title="SnapphaneScoutDistriktBookingApp">

    <Shell.FlyoutHeader>
        <Button Text="Byt tema" Clicked="OnClickedChangeTheme" />
    </Shell.FlyoutHeader>
    <FlyoutItem Title="Home" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Ny bokning"
            ContentTemplate="{DataTemplate booking:BookingPage}"
            Route="BookingPage" />
        
        <ShellContent
            Title="Info"
            ContentTemplate="{DataTemplate local:InfoPage}"
            Route="InfoPage" />

        <ShellContent
            Title="Admin" 
            ContentTemplate="{DataTemplate local:AdminPage}"
            Route="AdminPage" />

        <ShellContent
            Title="Logga in"
            ContentTemplate="{DataTemplate local:LoginPage}"
            Route="LoginPage" />
    </FlyoutItem>
</Shell>
